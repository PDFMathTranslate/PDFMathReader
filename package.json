{
  "name": "pdf-math-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "test": "node tests/run.mjs",
    "desktop": "bun run build && electron .",
    "package:mac": "bun run icons:mac && bun run build && node electron/build/package.mjs --distribute",
    "icons:mac": "node electron/build/generate-icon.mjs && swift electron/build/export-symbols.swift public/symbols",
    "package:win": "bun run build && node electron/build/package.mjs --platform=win32 --arch=x64 --distribute",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "style:check": "bun run lint && bun run format:check && node scripts/native-style.mjs check",
    "style:fix": "bun run lint:fix && bun run format && node scripts/native-style.mjs fix",
    "precommit": "lint-staged",
    "index:code": "node scripts/index-codegraph.mjs"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "latest",
    "@glass-sdk/liquid-glass": "0.0.1",
    "@thednp/dommatrix": "3.1.2",
    "express": "^5.1.0",
    "onnxruntime-node": "1.22.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "10.0.1",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@fluentui/web-components": "^3.1.3",
    "@macvue/core": "^0.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "vite": "^7.1.0",
    "vue": "^3.5.0"
  },
  "version": "0.1.5",
  "description": "Local PDF reader with paragraph translation",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "vue-demi"
  ]
}
